# ---------------------------------------------------------------
# Ware Print settings
# Copy this file to ".env.local" (for your computer) and fill in the
# values. On Vercel, add the same names under Settings → Environment
# Variables. SETUP-GUIDE.md explains where to find each value.
# ---------------------------------------------------------------

# Your website address, without a trailing slash.
# Use http://localhost:3000 on your computer, your real domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) --------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects call it the "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (older projects call it "service_role"). Never share it.
SUPABASE_SECRET_KEY=

# --- Who gets "new listing to review" and "sale reported" emails --
# One or more addresses, separated by commas.
ADMIN_NOTIFICATION_EMAILS=

# --- Email -------------------------------------------------------
# Until you own a domain: send through a Gmail account (SETUP-GUIDE.md, C1).
SMTP_USER=
# A Gmail "app password" (16 letters), NOT your normal Gmail password
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# After you buy a domain: Resend (resend.com → API Keys). If set, it is used instead of Gmail.
RESEND_API_KEY=
# Only used with Resend, e.g. Ware Print <noreply@yourdomain.com>
EMAIL_FROM=Ware Print <onboarding@resend.dev>

# --- WhatsApp (Meta WhatsApp Cloud API) — SETUP-GUIDE.md, C2 -------
# Verification codes and "new inquiry" alerts to sellers.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of your approved Authentication template (copy-code button)
WHATSAPP_OTP_TEMPLATE=
# Optional: name of your approved Utility template for inquiry alerts
WHATSAPP_INQUIRY_TEMPLATE=
# Language code you chose for the templates
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set to false to stop WhatsApp/SMS alerts for new inquiries (emails still go)
SEND_INQUIRY_ALERTS=true

# --- SMS through Twilio (optional backup, only if WhatsApp is not set up)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- Public contact details shown in the footer and Contact page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=
