# ---------------------------------------------------------------
# Ware Print settings
# Copy this file to ".env.local" (for your computer) and fill in the
# values. On Vercel, add the same names under Settings → Environment
# Variables. SETUP-GUIDE.md explains where to find each value.
# ---------------------------------------------------------------

# Your website address, without a trailing slash.
# Use http://localhost:3000 on your computer, your real domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) --------------------
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects call it the "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (older projects call it "service_role"). Never share it.
SUPABASE_SECRET_KEY=

# --- Who gets "new listing to review" and "sale reported" emails --
# One or more addresses, separated by commas.
ADMIN_NOTIFICATION_EMAILS=

# --- Email sending through Resend (resend.com → API Keys) -------
RESEND_API_KEY=
# Must use a domain you verified in Resend, e.g. Ware Print <noreply@yourdomain.com>
EMAIL_FROM=Ware Print <onboarding@resend.dev>

# --- SMS through Twilio (twilio.com → Console) ------------------
# Needed for phone verification codes and SMS inquiry alerts to sellers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Fill ONE of these two: a Twilio phone number, or a Messaging Service SID
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Set to false to stop SMS alerts for new inquiries (codes still go by SMS)
SEND_INQUIRY_SMS=true

# --- Public contact details shown in the footer and Contact page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=
